# God Mode Cut environment template.
# Copy to .env.local for local development. Never commit real values.
# Cloudflare Workers Builds needs the NEXT_PUBLIC_* values as build variables too.

# Required — Supabase project URL and publishable (anon) key. RLS is the gate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production — canonical origin, no trailing slash (also Supabase Auth Site URL).
NEXT_PUBLIC_SITE_URL=https://cut.example.com

# Optional white-label names (build variables). Defaults: "God Mode Cut" and "Studio HQ".
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT_NAME=
NEXT_PUBLIC_AGENCY_NAME=

# SERVER-ONLY SECRET (Cloudflare encrypted secret, never NEXT_PUBLIC_). Used for signed upload URLs,
# client invitations, the cron tick and Buffer secrets lookup. RLS still guards every user request.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY SECRET. The Worker cron and the local bridge call /api/cron/tick with this bearer token.
CRON_SECRET=

# SERVER-ONLY SECRET. Agency Buffer API key (developers.buffer.com → API key). A client that uses its own
# Buffer organization stores its key in the content_secrets table instead (service role only).
BUFFER_API_KEY=

# Optional SERVER-ONLY SECRET. Enables "Regenerate caption" on the server. Without it, captions come from the
# local bridge (Claude Code on the editing PC, no paid API) or are written by hand.
ANTHROPIC_API_KEY=

# --- Optional: post straight to YouTube and Instagram (no Buffer). Setup: docs/YOUTUBE.md, docs/INSTAGRAM.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Optional: phone notifications (Web Push). Generate the key pair once with your Web Push tool of choice.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
# Contact address sent to push services (yours, not a client's)
PUSH_CONTACT_EMAIL=

# --- Optional: your own signed Android app. Leave empty to hide the APK download and in-app updates.
NEXT_PUBLIC_ANDROID_PACKAGE=
NEXT_PUBLIC_ANDROID_APK_URL=

# --- Editing PC only (bridge). All optional.
# Command that cleans up a voice track: "<cmd> <input> <output.wav>"
VOICE_POLISH_CMD=
# Command that writes per-frame face positions: "<cmd> <video> <out.json>"
FACE_TRACK_CMD=
# Google Drive backup folder name for the editor folder
BACKUP_FOLDER=
